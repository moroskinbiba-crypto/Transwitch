#---------------------------------------------------------------------------------
# DeskNX - Nintendo Switch devkitA64 Makefile
# Builds self-contained DeskNX.nro with embedded RomFS
#---------------------------------------------------------------------------------
ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. Example: export DEVKITPRO=/opt/devkitpro")
endif

LIBNX    := $(DEVKITPRO)/libnx
PORTLIBS := $(DEVKITPRO)/portlibs/switch

include $(LIBNX)/switch_rules

#---------------------------------------------------------------------------------
# TARGET CONFIGURATION
#---------------------------------------------------------------------------------
TARGET      := DeskNX
BUILD       := build
SOURCES     := src-switch
INCLUDES    := include
ROMFS       := romfs

# NRO Metadata
APP_TITLE   := DeskNX
APP_AUTHOR  := Transwitch Team
APP_VERSION := 1.0.0
APP_ICON    := $(CURDIR)/icon.png

# Compiler Flags
ARCH        := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE
CFLAGS      := -g -Wall -O2 -ffunction-sections -fdata-sections $(ARCH) -D__SWITCH__
CFLAGS      += $(INCLUDE)
CXXFLAGS    := $(CFLAGS) -std=gnu++17 -fno-rtti -fno-exceptions
ASFLAGS     := -g $(ARCH)
LDFLAGS     = -specs=$(LIBNX)/switch.specs -g $(ARCH) -Wl,--gc-sections

LIBS        := -lnx
LIBDIRS     := $(PORTLIBS) $(LIBNX)

#---------------------------------------------------------------------------------
ifneq ($(BUILD),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export OUTPUT   := $(CURDIR)/$(TARGET)
export TOPDIR   := $(CURDIR)

export VPATH    := $(foreach dir,$(SOURCES),$(CURDIR)/$(dir))
export DEPSDIR  := $(CURDIR)/$(BUILD)

CFILES      := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES    := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
SFILES      := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))

ifeq ($(strip $(CPPFILES)),)
export LD := $(CC)
else
export LD := $(CXX)
endif

export OFILES_SRC := $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o)
export OFILES   := $(OFILES_SRC)

export INCLUDE  := $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
                   $(foreach dir,$(LIBDIRS),-I$(dir)/include) \
                   -I$(CURDIR)/$(BUILD)
export LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

export APP_TITLE APP_AUTHOR APP_VERSION
export ROMFS
ifneq ($(strip $(ROMFS)),)
export NROFLAGS += --romfsdir=$(CURDIR)/$(ROMFS)
endif
export APP_ICON

.PHONY: all clean nro

all: $(BUILD)
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile.switch

$(BUILD):
	@mkdir -p $@

clean:
	@echo "[DeskNX] Cleaning build..."
	@rm -rf $(BUILD) $(TARGET).elf $(TARGET).nro $(TARGET).nacp desknx.nro

else
#---------------------------------------------------------------------------------
# Inside build directory
#---------------------------------------------------------------------------------

DEPENDS := $(OFILES:.o=.d)

.PHONY: all

all: $(OUTPUT).nro
	@cp -f $(OUTPUT).nro $(TOPDIR)/desknx.nro 2>/dev/null || true
	@echo "============================================="
	@echo " SUCCESS: Built $(OUTPUT).nro and desknx.nro"
	@echo "============================================="

$(OUTPUT).nro: $(OUTPUT).elf $(OUTPUT).nacp

$(OUTPUT).elf: $(OFILES)

-include $(DEPENDS)

endif
